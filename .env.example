# MongoDB
MONGODB_URI=mongodb://localhost:27017/cloakroom
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cloakroom?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Stripe (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@cloakroom.ro
EMAIL_ADMIN=office@cloakroom.ro

# Company Details (configurable defaults)
COMPANY_NAME=Garderobă profesională
COMPANY_CUI=RO12345678
COMPANY_ADDRESS=Str. Exemplu nr. 1, București
COMPANY_PHONE=+40 700 000 000
COMPANY_EMAIL=office@cloakroom.ro

# Bank Details (for Bank Transfer)
BANK_NAME=Banca Transilvania
BANK_IBAN=RO49AAAA1B31007593840000
BANK_SWIFT=BTRLRO22

# Feature Flags
ENABLE_STRIPE_PAYMENTS=true
ENABLE_COD=true
ENABLE_BANK_TRANSFER=true
